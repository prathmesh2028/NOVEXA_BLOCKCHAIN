# Copy to backend/.env for local development. Never commit backend/.env.
NODE_ENV=development
APP_ENV=development
PORT=10000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Render PostgreSQL Internal Database URL (set this exact value in Render).
DATABASE_URL=postgresql://<render-user>:<password>@<render-internal-host>/<database>?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=kavachtrust
JWT_AUDIENCE=kavachtrust-api
JWT_EXPIRY=8h
CORS_ORIGINS=http://localhost:5173

# Required for production evidence uploads.
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kavachtrust-evidence

BLOCKCHAIN_MODE=demo
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK_NAME=BEL-TRUST-CHAIN
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1

WEBAUTHN_RP_NAME=KavachTrust
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
